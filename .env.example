# 本地开发默认值，复制为 .env 后填写真实值
APP_ENV=dev
APP_DATABASE_URL=postgresql+asyncpg://rentradar:rentradar_dev@127.0.0.1:5433/rentradar
APP_SECRET_KEY=change-me
APP_DOCS_ENABLED=false
APP_COOKIE_SECURE=false
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_TOKEN_DAYS=7
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_WINDOW_MINUTES=15
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_LOG_LEVEL=INFO
APP_CDP_URL=http://127.0.0.1:9333
APP_PYMD3_BIN=/home/data/venvs/pymd3/bin/pymobiledevice3
APP_IPCTL_BIN=/usr/local/bin/ipctl
PROBE_DEVICE_ID=iphone11pro

# 飞书应用机器人（RentRadar）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=open_id

# 地图
AMAP_WEB_KEY=
BAIDU_AK=
BAIDU_PROXY=

# 天地图服务端 Key；该 Key 绑定 10943 出口白名单
TIANDITU_API_KEY=
TIANDITU_PROXY=socks5h://127.0.0.1:10943

# 滴滴 MCP；默认沙箱，正式估价时把 URL 换成 /mcp-servers
DIDI_MCP_KEY=
DIDI_MCP_URL=https://mcp.didichuxing.com/mcp-servers-sandbox

# OpenCode Go 订阅网关（OpenAI 兼容 Chat Completions；Agent 首选模型）
# 该网关要求真实客户端 UA 与 x-opencode-session，客户端已内置；额度受 aiDailyCap 约束
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4.1-flash

# 魔搭 ModelScope（OpenAI 兼容，作为 AI Provider 兜底；免费额度约 2000 次/天）
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# P1: 封面图片缓存与天地图瓦片缓存（运行时目录，不提交）
APP_IMAGE_CACHE_DIR=data/images
APP_IMAGE_MAX_BYTES=6000000
APP_IMAGE_TIMEOUT_SECONDS=15
# 留空表示直连图片 CDN；需要时填 socks5h://
APP_IMAGE_PROXY=
# 视觉标签：启用后由 OpenCode Go（deepseek-v4.1-flash）按需分析封面；关闭时只做 dHash + 本地信号
APP_IMAGE_VISION_ENABLED=false
APP_MAP_TILE_CACHE_DIR=data/map-tiles
APP_MAP_TILE_TTL_DAYS=30

# P3: Agent 原生 tool_calls（默认关闭；关闭时仍走严格 JSON 计划 + 本地校验）
APP_AGENT_NATIVE_TOOLS=false

# P2: 运维告警 / 备份检查
# 磁盘检查路径；备份目录用于“备份过期/失败”告警，目录不存在时不告警
APP_ALERT_DISK_PATH=.
APP_BACKUP_DIR=/home/kkk/backups/rentradar
